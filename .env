# DO NOT ADD SECRETS TO THIS FILE. This is a good place for defaults.
# If you want to add secrets use `.env.local` instead.

NEXT_PUBLIC_WEBSITE_URL=https://alexdesroches.com

#https://totheweb.com/learning_center/tool-test-google-title-meta-description-lengths/
NEXT_PUBLIC_WEBSITE_TITLE="Alex Desroches"
NEXT_PUBLIC_WEBSITE_DESCRIPTION="Portfolio d'Alex Desroches - Services de programmation web."
NEXT_PUBLIC_WEBSITE_DESCRIPTION_EN="Alex Desroches's Web Development Portfolio."

NEXT_PUBLIC_WEBSITE_META_IMAGE="/images/ogImage.png"
NEXT_PUBLIC_WEBSITE_META_IMAGE_WIDTH="384"
NEXT_PUBLIC_WEBSITE_META_IMAGE_HEIGHT="384"
NEXT_PUBLIC_VERSION=$npm_package_version
